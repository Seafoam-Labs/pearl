# Ordinary Aqueous host; no restricted compositor mode required.
# Real greetd/desktop acceptance is tracked in GREETER_COMPATIBILITY.md.
# This example is never installed over /etc/greetd/config.toml by package hooks.
[terminal]
vt = 7
switch = true
[general]
source_profile = false
[default_session]
command = "/usr/lib/pearl/pearl-greeter-host"
user = "pearl-greeter"
