# Build only the catalogs from the checksum-pinned Pearl release source.
# Keep the translation package version independent of the application version.
pkgname=pearl-lang-de
pkgver=1.1
pkgrel=2
_sourcever=0.3.2
pkgdesc='German translations for Pearl and its bundled applications (partial coverage)'
arch=('any')
url='https://github.com/Seafoam-Labs/pearl'
license=('LicenseRef-Pearl-Unlicensed')
makedepends=('zig=0.16.0' 'gettext' 'tar')
# No dependency on the shell: the greeter can use this pack independently.
# Stable and development applications currently share catalog contract 1.
provides=('pearl-translations-de=1')
options=('!strip' '!debug')
source=("pearl-$_sourcever.tar.gz::$url/archive/refs/tags/v$_sourcever.tar.gz")
sha256sums=('738a006a64198c7293c8a5b01bf60e6f30422f9868cfd0e6b1f324753b436e08')

build() {
    cd "$srcdir/pearl-$_sourcever"
    export ZIG_GLOBAL_CACHE_DIR="${ZIG_GLOBAL_CACHE_DIR:-$srcdir/zig-cache}"
    zig build --build-file translations/build.zig -Dlanguage=de --prefix "$srcdir/catalog-stage"
}

check() {
    cd "$srcdir/pearl-$_sourcever"
    export ZIG_GLOBAL_CACHE_DIR="${ZIG_GLOBAL_CACHE_DIR:-$srcdir/zig-cache}"
    zig build --build-file translations/build.zig test check -Dlanguage=de
}

package() {
    install -d "$pkgdir/usr"
    cp -a "$srcdir/catalog-stage/share" "$pkgdir/usr/"
}
