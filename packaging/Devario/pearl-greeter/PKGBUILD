# Devario Core: standalone greeter from the v0.2.1 Pearl release tag.
# Installation selects Pearl Greeter for next boot without restarting services.
pkgname=pearl-greeter
pkgver=0.2.1
pkgrel=1
pkgdesc='GTK greetd login screen hosted by ordinary Aqueous'
arch=('x86_64')
url='https://github.com/Seafoam-Labs/pearl'
license=('LicenseRef-Pearl-Unlicensed')
conflicts=('pearl-greeter-git')
depends=('greetd>=0.10.3' 'aqueous>0.7' 'uwsm>=0.26.7' 'dbus' 'polkit'
         'gtk4>=1:4.22.5' 'glib2>=2.88.3' 'gtk4-layer-shell>=1.3.0' 'wayland>=1.26.0'
         'glibc>=2.44' 'systemd>=261.3' 'python>=3.14')
makedepends=('git' 'zig=0.16.0' 'pkgconf')
optdepends=('accountsservice: account names and avatars'
            'orca: optional screen reader'
            'xorg-xinit: optional X11 session launching')
backup=('etc/pearl/greeter.json')
install=pearl-greeter.install
options=('!strip' '!debug')
source=("pearl-$pkgver::git+$url.git#tag=v$pkgver"
        'pearl-greeter.install')
sha256sums=('SKIP'
            '0140157d9ac531b78f1fdb6bbb830a2c8f303e7424be565e37bb729c123b228e')

build() {
    cd "$srcdir/pearl-$pkgver"
    export ZIG_GLOBAL_CACHE_DIR="${ZIG_GLOBAL_CACHE_DIR:-$srcdir/zig-cache}"
    zig build build-greeter -Doptimize=ReleaseSafe -Drelease=true -Dcpu=baseline
}

check() {
    cd "$srcdir/pearl-$pkgver"
    export ZIG_GLOBAL_CACHE_DIR="${ZIG_GLOBAL_CACHE_DIR:-$srcdir/zig-cache}"
    zig build test-greeter-unit test-greeter-sync -Doptimize=ReleaseSafe -Dcpu=baseline
    python3 tests/test_greeter_package.py
    python3 tests/test_greeter_install.py
}

package() {
    cd "$srcdir/pearl-$pkgver"
    # stage.py requires a new directory; makepkg already creates pkgdir.
    local payload
    payload=$(mktemp -d "$srcdir/pearl-greeter-package.XXXXXX")
    python3 packaging/greeter/stage.py --system-package --dest "$payload/root"
    cp -R --preserve=mode,timestamps "$payload/root/." "$pkgdir/"
    rm -r "$payload"
}
