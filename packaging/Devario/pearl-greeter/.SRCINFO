pkgbase = pearl-greeter
	pkgdesc = GTK greetd login screen hosted by ordinary Aqueous
	pkgver = 0.2.1
	pkgrel = 1
	url = https://github.com/Seafoam-Labs/pearl
	install = pearl-greeter.install
	arch = x86_64
	license = LicenseRef-Pearl-Unlicensed
	makedepends = git
	makedepends = zig=0.16.0
	makedepends = pkgconf
	depends = greetd>=0.10.3
	depends = aqueous>0.7
	depends = uwsm>=0.26.7
	depends = dbus
	depends = polkit
	depends = gtk4>=1:4.22.5
	depends = glib2>=2.88.3
	depends = gtk4-layer-shell>=1.3.0
	depends = wayland>=1.26.0
	depends = glibc>=2.44
	depends = systemd>=261.3
	depends = python>=3.14
	optdepends = accountsservice: account names and avatars
	optdepends = orca: optional screen reader
	optdepends = xorg-xinit: optional X11 session launching
	conflicts = pearl-greeter-git
	options = !strip
	options = !debug
	backup = etc/pearl/greeter.json
	source = pearl-0.2.1::git+https://github.com/Seafoam-Labs/pearl.git#tag=v0.2.1
