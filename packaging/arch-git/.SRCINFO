pkgbase = pearl-git
	pkgdesc = GTK desktop shell exclusively for Aqueous (Git version)
	pkgver = 1.0.0rc2.r22.ga002d24
	pkgrel = 3
	url = https://github.com/Seafoam-Labs/pearl
	arch = x86_64
	license = LicenseRef-Pearl-Unlicensed
	makedepends = git
	makedepends = zig=0.16.0
	makedepends = pkgconf
	makedepends = python>=3.14
	depends = gtk4>=1:4.22.5
	depends = glib2>=2.88.3
	depends = gtk4-layer-shell>=1.3.0
	depends = libpulse>=17.0
	depends = pam>=1.7.2
	depends = polkit>=127
	depends = glibc>=2.44
	depends = wayland>=1.26.0
	depends = pango>=1:1.58.2
	depends = gdk-pixbuf2>=2.44.7
	depends = cairo>=1.18.4
	depends = systemd>=261.3
	depends = aqueous
	depends = uwsm>=0.26.7
	optdepends = matugen>=4.2.0: dynamic Material colors
	optdepends = networkmanager>=1.58.1: network controls
	optdepends = bluez>=5.87: Bluetooth controls
	optdepends = upower>=1.91.4: battery status
	optdepends = power-profiles-daemon>=0.30: power profiles
	options = !strip
	options = !debug
	backup = etc/pam.d/pearl-git
	source = pearl::git+https://github.com/Seafoam-Labs/pearl.git
	sha256sums = SKIP

pkgname = pearl-git
