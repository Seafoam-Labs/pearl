	depends = glib2>=2.88.3
	depends = gtk4-layer-shell>=1.3.0
	depends = libpulse>=17.0
	depends = pam>=1.7.2
	depends = polkit>=127
	depends = glibc>=2.44
	depends = wayland>=1.26.0
	depends = pango>=1:1.58.2
	depends = gdk-pixbuf2>=2.44.7
	depends = cairo>=1.18.4
	depends = xdg-desktop-portal
	depends = xdg-utils
	depends = glycin
	depends = matugen>=4.2.0
	depends = hunspell
	depends = systemd>=261.3
	depends = aqueous>0.7
	depends = uwsm>=0.26.7
	optdepends = pearl-assistant-runtime: optional local launcher answers; system or custom llama-server also supported
	optdepends = llama-cpp: system runtime for launcher assistant setup
	optdepends = sudo: authentication for assistant runtime installation with pacman
	optdepends = foot: terminal for interactive assistant runtime installation
	optdepends = gvfs: Trash, SFTP connections, and administrative filesystems in Phyto
	optdepends = gvfs-smb: SMB network connections in Phyto
	optdepends = gvfs-dnssd: WebDAV connections and network discovery in Phyto
	optdepends = file-roller: archive context menu actions in Phyto
	optdepends = poppler: PDF first-page previews in Phyto (requires bubblewrap)
	optdepends = ffmpeg: video still previews in Phyto (requires bubblewrap)
	optdepends = bubblewrap: sandbox required for PDF and video previews in Phyto
	optdepends = hunspell-en_us: English spelling dictionary for Coral (other Enchant dictionaries supported)
	optdepends = nvidia-utils: optional NVIDIA GPU metrics in Dome
	optdepends = qtengine: shared Qt 5/6 application appearance management
	optdepends = pearl-darkly-style: Darkly Qt application styles without KWin decorations
	optdepends = networkmanager>=1.58.1: network controls
	optdepends = bluez>=5.87: Bluetooth controls
	optdepends = upower>=1.91.4: battery status
	optdepends = power-profiles-daemon>=0.30: power profiles
	provides = pearl-capture-picker-git=1
	backup = etc/pam.d/pearl-git
	backup = etc/pearl-git/portal-policy.conf

pkgname = pearl-greeter-git
	pkgdesc = GTK greetd login screen hosted by ordinary Aqueous (Git version)
	install = pearl-greeter.install
	depends = greetd>=0.10.3
	depends = aqueous>0.7
	depends = uwsm>=0.26.7
	depends = dbus
	depends = polkit
	depends = gtk4>=1:4.22.5
	depends = glib2>=2.88.3
	depends = gtk4-layer-shell>=1.3.0
	depends = wayland>=1.26.0
	depends = glibc>=2.44
	depends = systemd>=261.3
	depends = python>=3.14
	optdepends = accountsservice: account names and avatars
	optdepends = orca: optional screen reader
	provides = pearl-greeter
	conflicts = pearl-greeter
	backup = etc/pearl/greeter.json
