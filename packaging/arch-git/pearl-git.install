post_install() {
    cat <<'EOF'
==> Pearl Git session setup
    For the Aqueous-Git desktop, run aqueous-welcome-git and select Pearl.
    Setup installs the matching aqueous-shell-pearl-git integration and saves
    the selection for your next login. For Aqueous-Intel-Git, use
    aqueous-welcome-intel-git instead.

    For the legacy aqueous-git package's "Aqueous" session, first disable your
    previous shell startup, then run as your normal user:
        systemctl --user daemon-reload
        systemctl --user enable pearl-git.service

    Log out and log back in. No extra uwsm start arguments are needed.
    Do not also enable pearl-git.service when using Aqueous-Git's shell selector.
EOF
}

post_upgrade() {
    post_install
}
