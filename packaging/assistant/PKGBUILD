# Optional inference dependency. The prebuilt upstream release is the required
# distribution integration boundary; Pearl's application code remains Zig.
pkgname=pearl-assistant-runtime
pkgver=0.9.5
pkgrel=1
pkgdesc="Optional prebuilt mistral.rs CPU runtime for Pearl (system mistralrs or custom builds also supported)"
arch=('x86_64')
url='https://github.com/EricLBuehler/mistral.rs'
license=('MIT')
depends=('glibc' 'libgcc')
options=('!strip' '!debug')
source=("mistralrs-cpu-x86_64-unknown-linux-gnu.tar.gz::$url/releases/download/v$pkgver/mistralrs-cpu-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('9b542da90b6541abd599ff275e3246fa6e144885bdcd67d1f0aefdba1729f7b5')

package() {
    local target="$pkgdir/usr/libexec/pearl/assistant"
    install -d "$target"
    install -m755 mistralrs "$target/mistralrs"
    printf '{"version":"v%s","source_sha256":"%s","backend":"cpu","source_kind":"prebuilt-release"}\n' \
        "$pkgver" "${sha256sums[0]}" > "$target/runtime.json"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
