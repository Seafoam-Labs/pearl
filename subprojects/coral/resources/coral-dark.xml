<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="coral-dark" name="Coral dark" version="1.0">
<author>Coral contributors</author>
<style name="text" foreground="#d6d7dc" background="#1b1d21"/>
<style name="selection" foreground="#d6d7dc" background="#e5a08e55"/>
<style name="line-numbers" foreground="#747985" background="#1b1d21"/>
<style name="current-line" background="#25272c"/>
<style name="cursor" foreground="#e5a08e"/>
<style name="def:comment" foreground="#92959f"/>
<style name="def:keyword" foreground="#e5a08e"/>
<style name="def:string" foreground="#9cbcac"/>
<style name="def:number" foreground="#e5a08e"/>
<style name="def:type" foreground="#9fb8cc"/>
<style name="def:heading" foreground="#e5a08e" bold="true"/>
<style name="def:link-text" foreground="#9fb8cc"/>
<style name="def:emphasis" foreground="#e5a08e" italic="true"/>
<style name="def:strong-emphasis" foreground="#e5a08e" bold="true"/>
<style name="search-match" background="#382c2b" foreground="#d6d7dc"/>
</style-scheme>
