<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="coral-light" name="Coral light" version="1.0">
<author>Coral contributors</author>
<style name="text" foreground="#1d1b20" background="#fdf7ff"/>
<style name="selection" foreground="#1d1b20" background="#6750a455"/>
<style name="line-numbers" foreground="#79747e" background="#fdf7ff"/>
<style name="current-line" background="#f7f2fa"/>
<style name="cursor" foreground="#6750a4"/>
<style name="def:comment" foreground="#79747e"/>
<style name="def:keyword" foreground="#6750a4"/>
<style name="def:string" foreground="#34704c"/>
<style name="def:number" foreground="#95542e"/>
<style name="def:type" foreground="#386297"/>
<style name="def:heading" foreground="#6750a4" bold="true"/>
<style name="def:link-text" foreground="#386297"/>
<style name="def:emphasis" foreground="#95542e" italic="true"/>
<style name="def:strong-emphasis" foreground="#6750a4" bold="true"/>
<style name="search-match" background="#eaddff" foreground="#21005d"/>
</style-scheme>
